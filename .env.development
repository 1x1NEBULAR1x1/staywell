# Database Configuration
POSTGRES_USER=staywell
POSTGRES_PASSWORD=staywell_password
POSTGRES_DATABASE=staywell_db

# Database URL for Prisma (used by backend and seeder)
DATABASE_URL=postgresql://staywell:staywell_password@localhost:5433/staywell_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Backend Configuration
PORT=3001
NODE_ENV=production

# JWT Configuration (for backend)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRATION=1d

# Stripe Configuration (for backend)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# File Upload Configuration
UPLOAD_DESTINATION=./uploads
MAX_FILE_SIZE=10485760

# Admin User (for seeding)
ADMIN_EMAIL=admin@staywell.com
ADMIN_PASSWORD=admin123